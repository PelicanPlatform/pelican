        "w": 5,
        "x": 12,
        "y": 67
      }
    },
    {
      "type": "timeseries",
      "title": "With tracing: overhead share over time",
      "description": "The exerciser mixes small objects, where overhead dominates, with 100 MB ones, where the transfer does.",
      "datasource": {
        "type": "prometheus",
