          "expr": "sum by (pelican_cache_result) (rate(traces_span_metrics_duration_milliseconds_sum{span_name=\"cache.serve_object\",pelican_cache_result!=\"\"}[5m])) / sum by (pelican_cache_result) (rate(traces_span_metrics_duration_milliseconds_count{span_name=\"cache.serve_object\",pelican_cache_result!=\"\"}[5m]))",
