      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pelican-metrics"
          },
          "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"pelican-client\", span_name=\"client.transfer\", status_code!=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
          "legendFormat": "ok",
          "refId": "A",
          "range": true,
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pelican-metrics"
          },
          "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"pelican-client\", span_name=\"client.transfer\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
          "legendFormat": "failed",
          "refId": "B",
          "range": true,
          "exemplar": false
        }
