{
  "uid": "pelican-downloads",
  "title": "Pelican object downloads",
  "description": "Downloads through the demo federation, from span metrics and traces.",
  "tags": [
    "pelican",
    "tracing"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "schemaVersion": 41,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "What Pelican tracing answers",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/pelican-questions/what-pelican-tracing-answers",
      "keepTime": true
    },
    {
      "title": "Pelican download lookup",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/pelican-trace/pelican-download-lookup",
      "keepTime": true
    },
    {
      "title": "Jaeger",
      "type": "link",
      "url": "http://localhost:16686/search?service=pelican-client",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Downloads (span metrics from the client's client.transfer span)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Downloads / s",
      "description": "Rate of client.transfer spans: one per `pelican object get`.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "pelican-metrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pelican-metrics"
          },
          "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"pelican-client\", span_name=\"client.transfer\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Failed downloads",
      "description": "Share of client.transfer spans with error status, over the last 5 minutes.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "pelican-metrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pelican-metrics"
          },
          "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"pelican-client\", span_name=\"client.transfer\", status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum(rate(traces_span_metrics_calls_total{service_name=\"pelican-client\", span_name=\"client.transfer\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Share of cache.serve_object spans with pelican.cache.result=hit, last 5 minutes.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "pelican-metrics"
