        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pelican-metrics"
          },
          "expr": "sum(rate(traces_span_metrics_calls_total{span_name=\"cache.serve_object\", pelican_cache_result=\"hit\"}[5m])) / sum(rate(traces_span_metrics_calls_total{span_name=\"cache.serve_object\", pelican_cache_result=~\"hit|miss\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
