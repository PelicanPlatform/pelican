# Pelican tracing demo.  Values here are defaults; a variable set in the
# shell overrides it (for example `GRAFANA_PORT=3001 make up`).

COMPOSE_PROJECT_NAME=pelican-otel-demo

# Pelican image, built from this repository by ./Dockerfile.
PELICAN_IMAGE=pelican-otel-demo:dev
# Stamped into the binaries; becomes service.version on spans.
PELICAN_VERSION=dev
GO_IMAGE=golang:1.26.11-alpine3.24
RUNTIME_IMAGE=alpine:3.24

# Observability images (the versions the upstream OpenTelemetry demo pins).
COLLECTOR_CONTRIB_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib:0.160.0
GRAFANA_IMAGE=grafana/grafana:13.2.1
# Not 2.21.0 as upstream: 2.21 removed the HTTP API under /api/ (services,
# traces) that Grafana's Jaeger datasource uses, so Grafana could not query it.
JAEGERTRACING_IMAGE=quay.io/jaegertracing/jaeger:2.19.0
PROMETHEUS_IMAGE=quay.io/prometheus/prometheus:v3.13.3

# Host ports.
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
# Not 8444, Pelican's own default web port, which a developer's machine is
# likely to have in use already.
DIRECTOR_PORT=18444

# Exerciser (see README section 6).
EXERCISER_INTERVAL=2
EXERCISER_WEIGHT_HIT=6
EXERCISER_WEIGHT_MISS=3
EXERCISER_WEIGHT_LARGE=1
EXERCISER_WEIGHT_SHARED=1
EXERCISER_WEIGHT_DIRECT=2
EXERCISER_WEIGHT_MISSING=1
EXERCISER_HIT_OBJECTS=5
EXERCISER_SMALL_SIZE_KB=512
EXERCISER_LARGE_SIZE_MB=100
EXERCISER_SHARED_SIZE_MB=20
EXERCISER_SHARED_CLIENTS=4
EXERCISER_RETAIN_MINUTES=10
EXERCISER_DEBUG=false
